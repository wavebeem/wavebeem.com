---
interface Props {
  drawer?: boolean;
}
const { drawer = false } = Astro.props;
---

<wavebeem-theme-select
  class:list={["theme-select", { "theme-select-drawer": drawer }]}
>
  <button type="button" class="theme-select-trigger" aria-haspopup="dialog">
    Choose theme&hellip;
  </button>
  <dialog class="theme-select-dialog" aria-label="Choose theme">
    <div class="theme-select-options">
      <button type="button" class="theme-select-option" data-theme="auto">
        Auto
      </button>
      <button type="button" class="theme-select-option" data-theme="light">
        Light
      </button>
      <button type="button" class="theme-select-option" data-theme="dark">
        Dark
      </button>
    </div>
    <button type="button" class="button theme-select-done">Done</button>
  </dialog>
</wavebeem-theme-select>

<script>
  const storageKey = "theme";
  const darkModeQuery = matchMedia("(prefers-color-scheme: dark)");

  const lightModeColor =
    document.querySelector<HTMLMetaElement>(
      `meta[name="theme-color"][media="(prefers-color-scheme: light)"]`,
    )?.content ?? "";
  const darkModeColor =
    document.querySelector<HTMLMetaElement>(
      `meta[name="theme-color"][media="(prefers-color-scheme: dark)"]`,
    )?.content ?? lightModeColor;

  const getStoredTheme = () => localStorage.getItem(storageKey) || "auto";
  const getSystemTheme = () => (darkModeQuery.matches ? "dark" : "light");

  function getResolvedTheme() {
    const stored = getStoredTheme();
    return stored === "auto" ? getSystemTheme() : stored;
  }

  function applyTheme() {
    const resolved = getResolvedTheme();
    document.documentElement.dataset.theme = resolved;
    const themeColorMeta = document.querySelector<HTMLMetaElement>(
      `meta[name="theme-color"]`,
    );
    if (themeColorMeta) {
      themeColorMeta.content =
        resolved === "dark" ? darkModeColor : lightModeColor;
    }
  }

  class WavebeemThemeSelect extends HTMLElement {
    #abortController = new AbortController();

    constructor() {
      super();
      const shadow = this.attachShadow({ mode: "open" });
      shadow.innerHTML = `<slot></slot>`;
    }

    connectedCallback() {
      this.#abortController = new AbortController();
      const { signal } = this.#abortController;

      const trigger = this.querySelector<HTMLButtonElement>(
        ".theme-select-trigger",
      )!;
      const dialog = this.querySelector<HTMLDialogElement>(
        ".theme-select-dialog",
      )!;
      const doneButton =
        this.querySelector<HTMLButtonElement>(".theme-select-done")!;
      const options = [
        ...this.querySelectorAll<HTMLButtonElement>(".theme-select-option"),
      ];

      const syncOptions = () => {
        const current = getStoredTheme();
        for (const option of options) {
          option.setAttribute(
            "aria-pressed",
            String(option.dataset.theme === current),
          );
        }
      };

      trigger.addEventListener(
        "click",
        () => {
          syncOptions();
          dialog.showModal();
          options
            .find((option) => option.dataset.theme === getStoredTheme())
            ?.focus();
        },
        { signal },
      );

      for (const option of options) {
        option.addEventListener(
          "click",
          () => {
            localStorage.setItem(storageKey, option.dataset.theme!);
            applyTheme();
            syncOptions();
          },
          { signal },
        );
      }

      doneButton.addEventListener("click", () => dialog.close(), { signal });

      // Close the dialog when clicking its backdrop (native <dialog>
      // doesn't do this on its own; Escape already works natively)
      dialog.addEventListener(
        "click",
        (event) => {
          if (event.target === event.currentTarget) {
            dialog.close();
          }
        },
        { signal },
      );

      // Re-applies when system theme changes, for users on "auto".
      darkModeQuery.addEventListener("change", applyTheme, { signal });
    }

    disconnectedCallback() {
      this.#abortController.abort();
    }
  }

  customElements.define("wavebeem-theme-select", WavebeemThemeSelect);

  applyTheme();

  // Apply theme parameters to the document (debug override, wins over
  // localStorage/system, e.g. `?theme=dark`)
  {
    const theme = new URL(location.href).searchParams.get("theme");
    if (theme) {
      document.documentElement.dataset.theme = theme;
    }
  }
</script>

<style>
  :global(html):has(.theme-select-dialog[open]) {
    overflow: hidden;
  }

  wavebeem-theme-select {
    display: flex;
  }

  .theme-select-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 8px 16px;
    border: none;
    border-radius: var(--rounded-large);
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;

    @media (hover) {
      &:hover {
        background-image: radial-gradient(var(--theme-hover-light));
      }
    }

    &:focus-visible {
      outline-color: currentColor;
      outline-offset: -2px;
    }
  }

  /* Same swap as .menu-drawer in menu.css; sits on --theme-sidebar-bg
     instead of the page background. */
  .theme-select-drawer .theme-select-trigger {
    background: var(--theme-sidebar-card);

    @media (hover) {
      &:hover {
        background-image: radial-gradient(var(--theme-sidebar-hover));
      }
    }
  }

  .theme-select-dialog {
    /* Author styles beat the UA's dialog:not([open]) rule regardless of
       specificity, so display must stay scoped to [open], or this
       renders in-flow even when closed. */
    flex-direction: column;
    /* m3.material.io/components/dialogs/specs's "padding between body
       and actions" (24dp). */
    gap: 24px;
    box-sizing: border-box;
    /* Same spec: container width min 280dp / max 560dp. fit-content so
       it hugs the (small) options row instead of always sitting at the
       floor. */
    width: fit-content;
    min-width: 280px;
    max-width: min(560px, calc(100vw - 32px));
    /* Spec: 24dp padding on all sides. */
    padding: 24px;
    border: none;
    /* Spec: 28dp corner radius. */
    border-radius: 28px;
    background: var(--theme-page-bg);
    color: var(--theme-page-text);
    box-shadow: 0 0 32px rgb(from var(--theme-text) r g b / 20%);

    &[open] {
      display: flex;
    }

    &::backdrop {
      background: var(--theme-scrim);
      opacity: 0.3;
      transition: opacity 150ms;

      @starting-style {
        opacity: 0;
      }
    }
  }

  .theme-select-options {
    display: flex;
    flex-direction: row;
    gap: 2px;
  }

  .theme-select-done {
    /* m3.material.io/components/dialogs/guidelines: "Buttons are aligned
       to the trailing edge of the dialog." Column-flex dialog defaults
       every child to stretch full-width otherwise. */
    align-self: flex-end;
  }

  .theme-select-option {
    flex: 1;
    padding: 8px 16px;
    border: 0;
    border-radius: var(--rounded-large);
    background: var(--theme-infobox);
    color: inherit;
    font: inherit;
    text-align: center;

    /* Connected button group: outer ends stay large, the corners where
       buttons meet go small. m3.material.io/components/button-groups/specs
       Skips the selected button -- it goes fully round regardless of
       position, see &[aria-pressed="true"] below. */
    :where(&) + &:not([aria-pressed="true"]) {
      border-top-left-radius: var(--rounded-small);
      border-bottom-left-radius: var(--rounded-small);
    }

    &:has(+ &):not([aria-pressed="true"]) {
      border-top-right-radius: var(--rounded-small);
      border-bottom-right-radius: var(--rounded-small);
    }

    @media (hover) {
      &:hover {
        background-image: radial-gradient(var(--theme-hover-light));
      }
    }

    &:focus-visible {
      outline-color: var(--theme-page-text);
      outline-offset: -2px;
      z-index: 1;
    }

    &[aria-pressed="true"] {
      /* Selection changes shape too, not just color, per M3 button-group
         spec ("...affect the shape of the button being selected"). */
      border-radius: var(--rounded-pill);
      background: var(--theme-toggle-selected-bg);
      color: var(--theme-toggle-selected-text);

      /* Standard text color is invisible against background, so offset it */
      &:focus-visible {
        outline-offset: 2px;
      }
    }
  }
</style>
