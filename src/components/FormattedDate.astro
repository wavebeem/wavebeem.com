---
import { toLocalDate } from "@/lib/localDate";

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "America/Los_Angeles",
});

interface Props {
  date: Date | string;
}
const { date: dateProp } = Astro.props;
const date = toLocalDate(dateProp);
---

<time datetime={date.toISOString()}>{dateFormatter.format(date)}</time>
