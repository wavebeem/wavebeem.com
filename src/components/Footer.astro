---
import { groups } from "@/data/menu";

const year = new Date().getFullYear();
---

<footer class="footer" id="footer">
  <div class="divider-wavy"></div>
  <nav class="footer-menu" aria-label="Footer">
    {
      groups.map((group) => (
        <ul>
          {group.map((item) => (
            <li>
              <a href={item.url}>{item.title}</a>
            </li>
          ))}
        </ul>
      ))
    }
  </nav>
  <div>
    <small>&copy; 2012&ndash;{year} wavebeem</small>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 8px;
    padding: 1rem;
    padding-top: 5rem;
    padding-bottom: calc(1rem + env(safe-area-max-inset-bottom, 1rem));
    color: var(--theme-bullet);
  }

  /* Shape/color come from divider.css's shared .divider-wavy rule.
     --m tweaked here for a bit more curve than the shared default. */
  .divider-wavy {
    margin-bottom: 1.5rem;

    /* Escape .footer's padding-inline for a true edge-to-edge wave,
       same trick page.css uses for in-content dividers on mobile. */
    @media (width < 40rem) {
      margin-inline: -1rem;
      width: calc(100% + 2rem);
    }

    /* Sidebar's own vertical wavy divider already provides that texture
       at this width -- one squiggle per layout, not two. */
    @media (width >= 70rem) {
      display: none;
    }
  }

  .footer > :not(.divider-wavy) {
    margin-inline: 0;
    max-width: none;
  }

  /* .footer > .footer-menu, not just .footer-menu: needs to match the
     specificity of ".footer > :not(.divider-wavy)" above so this max-width
     actually wins over that rule's max-content, instead of losing on
     specificity and leaving the grid hugging its own content width. */
  .footer > .footer-menu {
    display: grid;
    max-width: var(--width-heading);
    margin-bottom: 2.5rem;

    /* Redundant with the persistent Sidebar.astro at this width. */
    @media (width >= 70rem) {
      display: none;
    }

    /* data/menu.ts currently defines a single group (all 7 links), so
       this is really styling one list, not laying multiple groups side
       by side -- two columns instead of one long vertical run. */
    ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px 32px;
      align-content: start;

      @media (width <= 21rem) {
        grid-template-columns: 1fr;
      }
    }

    a {
      display: block;
      color: var(--theme-link);
      font-size: var(--font-size-small);
      padding: 8px 8px;
      text-decoration-line: none;
    }
  }
</style>
