---
import Logo from "./Logo.astro";
import ThemeSelect from "./ThemeSelect.astro";
import { groups } from "@/data/menu";
---

<aside class="sidebar">
  <a href="/" role="presentation" class="sidebar-top">
    <Logo />
  </a>
  <nav aria-label="Primary">
    {
      groups.map((group) => (
        <div class="nav-group">
          {group.map((item) => (
            <a class="nav-link" href={item.url}>
              {item.title}
            </a>
          ))}
        </div>
      ))
    }
  </nav>
  <ThemeSelect />
</aside>

<style>
  .sidebar {
    display: none;

    @media (width >= 70rem) {
      display: flex;
      flex-direction: column;
      gap: 24px;
      box-sizing: border-box;
      /* Sticky, not its own scroll region (see .page-shell). Capped to
         viewport height with its own scrollbar so a short window can't
         strand nav items below the fold. */
      position: sticky;
      top: 0;
      max-height: 100vh;
      overflow-y: auto;
      /* overflow-y: auto implicitly makes overflow-x auto too (per
         spec), which shows a scrollbar from sub-pixel flex rounding.
         Never supposed to scroll sideways. */
      overflow-x: hidden;
      /* Without this, scrolling past the nav's edge chains into
         scrolling <body> underneath it. */
      overscroll-behavior: contain;
      padding: 24px;
      /* Aligns with the visible top of the page title's glyphs, not
         its taller line box; not an arbitrary round number. */
      padding-top: calc(24px + 2px);
      padding-right: 8px;
      /* No panel background/shadow; separated from content by space,
         not a color block, so nav reads as part of the page canvas.
         .sidebar-top below is the one exception. */
      color: var(--theme-page-text);
    }
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* .nav-group/.nav-link are shared with Header.astro's mobile nav-menu
     drawer -- see nav-link.css. */

  .sidebar-top {
    display: flex;
    padding: 8px 16px;
    border-radius: var(--rounded-large);
    color: var(--theme-accent);

    /* :global needed: Logo.astro injects raw SVG via set:html. */
    :global(svg) {
      height: 28px;
      width: auto;
    }

    @media (hover) {
      &:hover {
        background-image: radial-gradient(var(--theme-hover-light));
      }
    }

    &:focus-visible {
      outline-offset: -2px;
    }
  }
</style>
