---
import { MenuIcon, XIcon } from "@lucide/astro";
import Logo from "./Logo.astro";
import ThemeSelect from "./ThemeSelect.astro";
import { groups } from "@/data/menu";
---

<header class="header">
  <div class="header-content">
    <span class="logo">
      <a href="/" role="presentation">
        <Logo />
      </a>
    </span>
    <nav class="nav" aria-label="Menu">
      <button type="button" class="hamburger" aria-label="Open menu">
        <MenuIcon />
      </button>
    </nav>
  </div>
  <dialog class="nav-menu">
    <form method="dialog" class="nav-menu-toolbar">
      <button type="submit" class="nav-menu-close" aria-label="Close menu">
        <XIcon />
      </button>
    </form>
    <div class="nav-menu-content">
      <nav aria-label="Primary">
        {
          groups.map((group) => (
            <div class="nav-group">
              {group.map((item) => (
                <a class="nav-link" href={item.url}>
                  {item.title}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
      <div class="paragraph">
        <ThemeSelect />
      </div>
    </div>
  </dialog>
</header>
<hr />

<script>
  const navMenu = document.querySelector<HTMLDialogElement>(".nav-menu")!;

  for (const hamburger of document.querySelectorAll<HTMLElement>(
    ".hamburger",
  )) {
    hamburger.addEventListener("click", () => {
      navMenu.showModal();
    });
  }

  // Close the nav menu dialog when clicking its backdrop (native <dialog>
  // doesn't do this on its own; Escape and the in-dialog close button
  // already work natively)
  navMenu.addEventListener("click", (event) => {
    if (event.target === event.currentTarget) {
      navMenu.close();
    }
  });
</script>

<style>
  :global(html):has(.nav-menu[open]) {
    overflow: hidden;
  }

  hr {
    margin-block: -8px;

    @media (width >= 70rem) {
      display: none;
    }
  }

  .header {
    background: var(--theme-header-bg);
    color: var(--theme-header-text);
    /* border-bottom: 1px solid var(--theme-divider); */

    display: flex;
    justify-content: center;
    padding-inline: 16px;

    /* At desktop width, logo and theme selector live in Sidebar.astro
       instead, and the hamburger is hidden below; nothing left to
       show. */
    @media (width >= 70rem) {
      display: none;
    }
  }

  .header-content {
    width: 100%;

    /* No max-width: this bar only shows below 70rem, and unlike the
       reading column below it, it's just a logo + hamburger with
       space-between, so it should fill the bar edge-to-edge instead
       of capping at the content width and floating in the middle. */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;

    box-sizing: border-box;

    /* Horizontal spacing comes from .header's own padding-inline; this
       used to also pad horizontally here, doubling up on top of that. */
    padding-block: 16px;
  }

  .logo {
    display: grid;
    align-items: center;
  }

  .logo a {
    position: relative;
    pointer-events: initial;
    line-height: 1;
    width: 100%;
    height: 24px;
    display: flex;
    outline-offset: 4px;
    border-radius: var(--rounded-small);
    color: var(--theme-accent);

    @media (width >= 70rem) {
      height: 32px;
    }
  }

  .logo a:hover:not(:focus-visible)::after {
    content: "";
    width: 100%;
    position: absolute;
    left: 0;
    background: currentColor;
    bottom: calc(
      -1 *
        (var(--link-underline-offset) + var(--link-underline-thickness-hover))
    );
    height: var(--link-underline-thickness-hover);
  }

  @media (width < 40rem) {
    .header {
      padding-top: 0px;
    }
  }

  .nav {
    fill: currentColor;
    stroke: currentColor;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav .hamburger {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    padding: 0;
    width: 40px;
    height: 40px;
    box-sizing: border-box;
    border-radius: var(--rounded-large);
    border: 0;
    background: transparent;
    color: var(--theme-accent);
    stroke: currentColor;
    pointer-events: auto;
    box-shadow: none;

    @media (hover) {
      &:hover {
        background-image: radial-gradient(var(--theme-hover-light));
      }
    }

    &:focus-visible {
      outline: 2px dotted currentColor;
      outline-offset: -2px;
    }

    /* Sidebar.astro replaces this at desktop width. */
    @media (width >= 70rem) {
      display: none;
    }
  }

  .nav-menu {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(360px, 100%);
    height: 100%;
    border: none;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    background: var(--theme-sidebar-bg);
    color: var(--theme-sidebar-text);
    max-width: 18rem;
    max-height: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow:
      0 0 16px rgb(from var(--theme-shadow) r g b / 40%),
      0 0 32px rgb(from var(--theme-shadow) r g b / 20%);

    translate: 100% 0;
    transition:
      translate var(--motion-duration-medium1) var(--motion-easing-standard),
      overlay var(--motion-duration-medium1) var(--motion-easing-standard) allow-discrete,
      display var(--motion-duration-medium1) var(--motion-easing-standard) allow-discrete;

    &[open] {
      translate: 0 0;

      @starting-style {
        translate: 100% 0;
      }
    }
  }

  .nav-menu::backdrop {
    background: rgb(from var(--theme-scrim) r g b / 50%);
    opacity: 0;
    transition:
      opacity var(--motion-duration-medium1) var(--motion-easing-standard),
      overlay var(--motion-duration-medium1) var(--motion-easing-standard) allow-discrete,
      display var(--motion-duration-medium1) var(--motion-easing-standard) allow-discrete;
  }

  .nav-menu[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .nav-menu[open]::backdrop {
      opacity: 0;
    }
  }

  .nav-menu-content {
    padding: 16px;

    /* Scoped to this nav specifically -- .nav up top (wrapping the
       hamburger button) is a different element. */
    > nav {
      display: flex;
      flex-direction: column;
      gap: 24px;
      margin-bottom: 24px;
    }
  }

  .nav-menu-toolbar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    padding: 16px 16px 24px;
    margin-bottom: -24px;
    background: linear-gradient(var(--theme-sidebar-bg), transparent);
    pointer-events: none;
  }

  .nav-menu-close {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    padding: 0;
    width: 40px;
    height: 40px;
    box-sizing: border-box;
    border-radius: var(--rounded-large);
    border: 0;
    background: transparent;
    color: var(--theme-accent);
    stroke: currentColor;
    pointer-events: auto;
    box-shadow: none;

    @media (hover) {
      &:hover {
        background-image: radial-gradient(var(--theme-hover-light));
      }
    }

    &:focus-visible {
      outline: 2px dotted currentColor;
      outline-offset: -2px;
    }
  }
</style>
