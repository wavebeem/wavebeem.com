---
import "../styles/base.css";
import Head from "@/components/Head.astro";
import Header from "@/components/Header.astro";
import Sidebar from "@/components/Sidebar.astro";
import Footer from "@/components/Footer.astro";
import wavyH from "@/icons/divider-wavy-h.svg?raw";
import wavyV from "@/icons/divider-wavy-v.svg?raw";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "" } = Astro.props;

// Astro's ?raw import loads the real .svg files as source text, and
// encodeURIComponent does the data-URI escaping correctly (a hand-rolled
// version of this went wrong once already -- see divider.css). Exposed
// as CSS custom properties (below) on <html> so every .astro/.css file
// can share one definition instead of duplicating the wave shape.
const maskWavyH = `url("data:image/svg+xml,${encodeURIComponent(wavyH)}")`;
const maskWavyV = `url("data:image/svg+xml,${encodeURIComponent(wavyV)}")`;
---

<html lang="en" style={`--mask-wavy-h: ${maskWavyH}; --mask-wavy-v: ${maskWavyV};`}>
  <head>
    <Head title={title} description={description} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <div class="page-shell">
      <Sidebar />
      <div class="content">
        <main class="main" id="main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    z-index: 100;
    padding: 16px 32px;
    background: var(--theme-page-bg);
    color: var(--theme-page-text);
    border-radius: var(--rounded-large);
    margin: 8px;
    translate: 0% -100%;
    text-decoration-line: none;
    font-weight: bold;

    &:focus {
      translate: 0%;
      outline-offset: -6px;
    }

    @media (width < 70rem) {
      display: none;
    }
  }

  .page-shell {
    /* Fills body's min-height: 100vh so Footer can be pushed to the
       bottom on short pages. */
    flex: 1;
    display: flex;
    flex-direction: column;

    @media (width >= 70rem) {
      /* <body> scrolls normally at every width; no independently
         scrolling regions. Sidebar.astro stays in view via its own
         sticky + overflow-y instead. */
      display: grid;
      grid-template-columns: var(--sidebar-width) 1fr;
      /* Row fills the grid's full height, so .content can stretch
         into it below. Always 2 columns, no third balancing column or
         width cap on .page-shell itself: the sidebar stays pinned to
         the viewport edge at every width (a stable anchor, not
         something that drifts and grows a scroll-distance gap as the
         window widens); .content caps and centers itself instead, see
         below. */
      grid-template-rows: 1fr;
    }
  }

  .content {
    /* Fills .page-shell's height so .main below can push Footer down. */
    flex: 1;
    display: flex;
    flex-direction: column;

    @media (width >= 70rem) {
      padding-top: 0px;
      padding-inline: 0px;
      /* Caps and centers within the remaining 1fr column, independent
         of the sidebar. width-heading, not page-shell-max-width: that
         var accounted for a phantom balancing sidebar column that no
         longer exists now that .page-shell itself isn't capped. */
      max-width: var(--width-heading);
      margin-inline: auto;
    }
  }

  .main {
    /* Grows to fill .content, pushing Footer to the bottom on short
       pages. */
    flex: 1;
  }
</style>

<script>
  // Add date information to document
  {
    const weekdays = [
      "sunday",
      "monday",
      "tuesday",
      "wednesday",
      "thursday",
      "friday",
      "saturday",
    ];
    const date = new Date();
    const root = document.documentElement;
    root.dataset.year = String(date.getFullYear());
    root.dataset.month = String(date.getMonth() + 1);
    root.dataset.date = String(date.getDate());
    root.dataset.day = weekdays[date.getDay()];
  }

  // Enable JS figure image viewer
  {
    document.documentElement.dataset.figureViewer = "";
    addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) {
        return;
      }
      const img = event.target.closest("img");
      const parent = img?.closest("figure") || img?.closest("p");
      const anchor = img?.closest("a");
      if (!(img && parent && !anchor)) {
        return;
      }
      event.preventDefault();
      location.href = img.src;
    });
  }
</script>
