---
import "../styles/base.css";
import Head from "@/components/Head.astro";
import Header from "@/components/Header.astro";
import Sidebar from "@/components/Sidebar.astro";
import Footer from "@/components/Footer.astro";
import wavyH from "@/icons/divider-wavy-h.svg?raw";
import wavyV from "@/icons/divider-wavy-v.svg?raw";
import chevronDown from "@/icons/chevron-down.svg?raw";
import { dataUri } from "@/lib/dataUri";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "" } = Astro.props;

// Astro's ?raw import loads the real .svg files as source text, and
// dataUri()'s encodeURIComponent does the data-URI escaping correctly (a
// hand-rolled version of this went wrong once already -- see divider.css).
// Exposed as CSS custom properties (below) on <html> so every .astro/.css
// file can share one definition instead of duplicating the wave shape.
const maskWavyH = dataUri("image/svg+xml", wavyH);
const maskWavyV = dataUri("image/svg+xml", wavyV);
const maskChevronDown = dataUri("image/svg+xml", chevronDown);
const htmlStyle = `
  --mask-wavy-h: ${maskWavyH};
  --mask-wavy-v: ${maskWavyV};
  --mask-chevron-down: ${maskChevronDown};
`;
---

<html lang="en" style={htmlStyle}>
  <head>
    <Head title={title} description={description} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <div class="page-shell">
      <Sidebar />
      <div class="content">
        <main class="main" id="main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    z-index: 100;
    padding: 8px 16px;
    background: var(--theme-button-bg);
    color: var(--theme-button-text);
    border-radius: var(--rounded-pill);
    /* margin: 8px; */
    translate: 16px -100%;
    text-decoration-line: none;
    font-weight: bold;
    transition: translate var(--motion-duration-short3) var(--motion-easing-standard);

    &:focus {
      translate: 16px 16px;
      outline-offset: -2px;
    }

    @media (width < 70rem) {
      display: none;
    }
  }

  .page-shell {
    /* Fills body's min-height: 100vh so Footer can be pushed to the
       bottom on short pages. */
    flex: 1;
    display: flex;
    flex-direction: column;

    @media (width >= 70rem) {
      /* <body> scrolls normally at every width; no independently
         scrolling regions. Sidebar.astro stays in view via its own
         sticky + overflow-y instead. */
      display: grid;
      grid-template-columns: var(--sidebar-width) 1fr;
      /* Row fills the grid's full height, so .content can stretch
         into it below. The sidebar stays pinned to the viewport edge
         at every width (a stable anchor, not something that drifts);
         .content caps and centers itself, see below. */
      grid-template-rows: 1fr;
    }

    /* Past this width, an empty third column matching the sidebar's
       width balances it, so .content centers on the true viewport
       instead of the leftover space right of the sidebar (which skews
       it right by half the sidebar's width). Nothing renders in this
       column -- it's just a phantom spacer. */
    @media (width >= 110rem) {
      grid-template-columns: var(--sidebar-width) 1fr var(--sidebar-width);
    }
  }

  .content {
    /* Fills .page-shell's height so .main below can push Footer down. */
    flex: 1;
    display: flex;
    flex-direction: column;

    @media (width >= 70rem) {
      padding-top: 0px;
      padding-inline: 0px;
      /* width: 100% -- not just max-width -- so short pages (About,
         Extras) still fill the 1fr column instead of shrinking to their
         content; max-width then caps that at the reading width. Caps and
         centers within the 1fr column. Below 100rem that's the leftover
         space right of the sidebar; past it, .page-shell's phantom third
         column balances things out so this centers on the true viewport
         instead. */
      width: 100%;
      max-width: var(--width-heading);
      margin-inline: auto;
    }
  }

  .main {
    /* Grows to fill .content, pushing Footer to the bottom on short
       pages. */
    flex: 1;
  }
</style>

<script>
  // Add date information to document
  {
    const weekdays = [
      "sunday",
      "monday",
      "tuesday",
      "wednesday",
      "thursday",
      "friday",
      "saturday",
    ];
    const date = new Date();
    const root = document.documentElement;
    root.dataset.year = String(date.getFullYear());
    root.dataset.month = String(date.getMonth() + 1);
    root.dataset.date = String(date.getDate());
    root.dataset.day = weekdays[date.getDay()];
  }

  // Enable JS figure image viewer
  {
    document.documentElement.dataset.figureViewer = "";
    addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) {
        return;
      }
      const img = event.target.closest("img");
      const parent = img?.closest("figure") || img?.closest("p");
      const anchor = img?.closest("a");
      if (!(img && parent && !anchor)) {
        return;
      }
      event.preventDefault();
      location.href = img.src;
    });
  }
</script>
