<style>
  /* Intentional exception to the theme-tokens-only rule (see theme.css):
     this is a raw reference chart of the --md-* primitives themselves. */

  .color-roles-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-block: 16px;

    .color-roles {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
    }

    .color-roles-swatch {
      display: flex;
      align-items: flex-start;
      flex: 1;
      min-height: 64px;
      padding: 8px;
      font-size: 0.75rem;
      line-height: 1.15;
      font-weight: 600;
      letter-spacing: var(--tracking-label);
    }

    /* An "on-X" swatch stacked directly against the X it's meant to sit on
       (e.g. On Primary under Primary) -- no gap, so they read as one
       surface with two ink colors rather than two separate swatches.
       Matches m3.material.io/styles/color/roles. */
    .color-roles-pair {
      display: flex;
      flex-direction: column;
    }

    .color-roles-swatch--wide {
      flex: 2;
    }

    .color-roles-swatch--small {
      min-height: 40px;
    }

    .color-roles-accent {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      flex: 3 1 480px;
    }

    .color-roles-accent-column {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .color-roles-fixed {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      flex: 3 1 480px;
    }

    .color-roles-fixed-group {
      display: flex;
      flex-direction: column;
    }

    .color-roles-fixed-top {
      display: flex;
    }

    .color-roles-error-inverse {
      display: flex;
      gap: 16px;
      flex: 1 1 320px;
    }

    .color-roles-error {
      display: flex;
      flex-direction: column;
      gap: 2px;
      flex: 1 1 160px;
    }

    .color-roles-inverse {
      display: flex;
      flex-direction: column;
      gap: 2px;
      flex: 1 1 160px;
    }

    .color-roles-scrim-shadow {
      display: flex;
      gap: 2px;
    }

    .color-roles-surface {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .color-roles-surface-row {
      display: flex;
    }

    @media (width < 40rem) {
      .color-roles-accent,
      .color-roles-fixed {
        grid-template-columns: 1fr;
      }

      .color-roles-error-inverse,
      .color-roles-fixed-top,
      .color-roles-scrim-shadow,
      .color-roles-surface-row {
        flex-direction: column;
      }
    }

    /* Accent roles */
    [data-role="primary"] {
      background: var(--md-primary);
      color: var(--md-on-primary);
    }
    [data-role="on-primary"] {
      background: var(--md-surface);
      color: var(--md-primary);
    }
    [data-role="primary-container"] {
      background: var(--md-primary-container);
      color: var(--md-on-primary-container);
    }
    [data-role="on-primary-container"] {
      background: var(--md-on-primary-container);
      color: var(--md-primary-container);
    }

    [data-role="secondary"] {
      background: var(--md-secondary);
      color: var(--md-on-secondary);
    }
    [data-role="on-secondary"] {
      background: var(--md-surface);
      color: var(--md-secondary);
    }
    [data-role="secondary-container"] {
      background: var(--md-secondary-container);
      color: var(--md-on-secondary-container);
    }
    [data-role="on-secondary-container"] {
      background: var(--md-on-secondary-container);
      color: var(--md-secondary-container);
    }

    [data-role="tertiary"] {
      background: var(--md-tertiary);
      color: var(--md-on-tertiary);
    }
    [data-role="on-tertiary"] {
      background: var(--md-surface);
      color: var(--md-tertiary);
    }
    [data-role="tertiary-container"] {
      background: var(--md-tertiary-container);
      color: var(--md-on-tertiary-container);
    }
    [data-role="on-tertiary-container"] {
      background: var(--md-on-tertiary-container);
      color: var(--md-tertiary-container);
    }

    [data-role="error"] {
      background: var(--md-error);
      color: var(--md-on-error);
    }
    [data-role="on-error"] {
      background: var(--md-surface);
      color: var(--md-error);
    }
    [data-role="error-container"] {
      background: var(--md-error-container);
      color: var(--md-on-error-container);
    }
    [data-role="on-error-container"] {
      background: var(--md-on-error-container);
      color: var(--md-error-container);
    }

