---
import PageLayout from "@/layouts/PageLayout.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { images as artImages } from "@/data/art";

const images = artImages.toReversed();
---

<PageLayout title="Art">
  <p>I've been drawing pixel art since I learned mspaint.exe could zoom in.</p>

  <div class="photo-grid">
    {
      images.map((image) => (
        <figure data-size="large">
          <img
            src={image.path}
            loading="lazy"
            alt=""
            width="600"
            height="600"
          />
          <figcaption>
            <a href={image.path}>
              <strong>{image.title}</strong>
            </a>
            <br />
            <FormattedDate date={image.date} />
          </figcaption>
        </figure>
      ))
    }
  </div>
</PageLayout>
